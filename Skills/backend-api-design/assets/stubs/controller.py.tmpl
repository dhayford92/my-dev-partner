"""
__Resource__ controller — CRUD with the canonical pagination envelope + activity logging.
"""
import logging
from uuid import UUID
from datetime import datetime, timezone

from fastapi import HTTPException, status, Request

from src.apps.__domain__.models.__resource___model import __Resource__Model
from src.schemas.shared.base import ErrorCodes, PaginationParams, create_paginated_response
from src.schemas.shared.responses import SuccessResponse
from src.schemas.__domain__.__resource___schemas import (
    Create__Resource__Schema, Update__Resource__Schema,
    __Resource__DetailSchema, __Resource__TableSchema, __Resource__ListSchema,
)
from src.services.activity.activity_service import ActivityService

logger = logging.getLogger(__name__)


class __Resource__Controller:
    @staticmethod
    async def list(params: PaginationParams) -> __Resource__ListSchema:
        qs = __Resource__Model.filter(deleted_at=None)
        total = await qs.count()
        rows = await qs.order_by("-created_at").offset(params.offset).limit(params.limit)
        return create_paginated_response(
            [__Resource__TableSchema.model_validate(r) for r in rows],
            params.page, params.limit, total,
        )

    @staticmethod
    async def get(__resource___id: UUID) -> __Resource__DetailSchema:
        row = await __Resource__Model.get_or_none(id=__resource___id, deleted_at=None)
        if not row:
            raise HTTPException(status.HTTP_404_NOT_FOUND, detail="__Resource__ not found",
                                headers={"X-Error-Code": ErrorCodes.RESOURCE_NOT_FOUND})
        return __Resource__DetailSchema.model_validate(row)

    @staticmethod
    async def create(body: Create__Resource__Schema, actor_id: UUID, request: Request) -> __Resource__DetailSchema:
        try:
            row = await __Resource__Model.create(**body.model_dump())
            await ActivityService.log_create(actor_id, "__resource__", row.id, row.name, request=request)
            return __Resource__DetailSchema.model_validate(row)
        except HTTPException:
            raise
        except Exception as e:  # noqa: BLE001
            logger.error(f"__Resource__ create error: {e}")
            raise HTTPException(status.HTTP_500_INTERNAL_SERVER_ERROR, detail="Failed to create __resource__")

    @staticmethod
    async def update(__resource___id: UUID, body: Update__Resource__Schema, actor_id: UUID,
                     request: Request) -> __Resource__DetailSchema:
        row = await __Resource__Model.get_or_none(id=__resource___id, deleted_at=None)
        if not row:
            raise HTTPException(status.HTTP_404_NOT_FOUND, detail="__Resource__ not found",
                                headers={"X-Error-Code": ErrorCodes.RESOURCE_NOT_FOUND})
        changes = body.model_dump(exclude_none=True)
        for field, value in changes.items():
            setattr(row, field, value)
        await row.save()
        await ActivityService.log_update(actor_id, "__resource__", row.id, row.name,
                                         changes=changes, request=request)
        return __Resource__DetailSchema.model_validate(row)

    @staticmethod
    async def delete(__resource___id: UUID, actor_id: UUID, request: Request) -> SuccessResponse:
        row = await __Resource__Model.get_or_none(id=__resource___id, deleted_at=None)
        if not row:
            raise HTTPException(status.HTTP_404_NOT_FOUND, detail="__Resource__ not found",
                                headers={"X-Error-Code": ErrorCodes.RESOURCE_NOT_FOUND})
        row.deleted_at = datetime.now(timezone.utc)
        await row.save(update_fields=["deleted_at"])
        await ActivityService.log_delete(actor_id, "__resource__", row.id, row.name, request=request)
        return SuccessResponse(message="__Resource__ deleted successfully")
