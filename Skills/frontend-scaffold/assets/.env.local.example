# Backend API base URL (no trailing slash). apiFetch + api-urls.ts build on this.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Cookie namespace → <slug>_access_token, <slug>_refresh_token, <slug>_session.
# Use a short unique slug per app so multiple apps on one domain don't collide.
NEXT_PUBLIC_APP_SLUG=app

# App's own public base URL (used for share links, absolute redirects). Optional.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
