# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=App API
APP_VERSION=1.0.0
DEBUG=true
RELOAD=true
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# For a zero-infra first boot you may use sqlite:  DATABASE_URL=sqlite://db.sqlite3
DATABASE_URL=postgres://app:app_password@localhost:5432/app_dev
DATABASE_POOL_SIZE=20
DATABASE_POOL_MAX_OVERFLOW=10

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# ── JWT ──────────────────────────────────────────────────────────────────────
API_SECRET_KEY=change-me-in-production-use-a-256-bit-hex-secret
API_ALGORITHM=HS256
JWT_ISSUER=app-api
JWT_AUDIENCE=app-frontend
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_BASE_URL=http://localhost:3000

# ── Email (Resend) ───────────────────────────────────────────────────────────
MAIL_API_KEY=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=App

# ── Cloud Storage (DigitalOcean Spaces) ──────────────────────────────────────
BUCKET_URL=
BUCKET_KEY=
BUCKET_SECRET=
BUCKET_NAME=
BUCKET_REGION_ENDPOINT=https://lon1.digitaloceanspaces.com

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute

# ── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Seeder (default super admin) ─────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123
